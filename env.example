# env.example
# If using OpenAI API for generation:
OPENAI_API_KEY=

# Path to data
DATA_PATH=./data/finance_sample.csv

# Where to write index and metadata
INDEX_DIR=./data/index
METADATA_DB=./data/metadata.db

# Embedding model - sentence-transformers model name
EMBEDDING_MODEL=all-MiniLM-L6-v2

# For local HF text generation (optional)
HF_MODEL=facebook/opt-350m   # example small model; replace if you have a different local model
